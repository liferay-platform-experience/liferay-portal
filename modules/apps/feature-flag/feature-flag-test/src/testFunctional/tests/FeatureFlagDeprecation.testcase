@component-name = "portal-feature-flag"
definition {

	property custom.properties = "feature.flag.LPS-162766=true${line.separator}feature.flag.LPS-162766.description=Test Deprecation Description 404 sample page${line.separator}feature.flag.LPS-162766.title=Test Deprecation Title 404 sample page${line.separator}feature.flag.LPS-162766.type=deprecation${line.separator}feature.flag.ui.visible[deprecation]=true";
	property portal.release = "true";
	property portal.upstream = "true";
	property testray.component.names = "Feature Flag";
	property testray.main.component.name = "Feature Flag";

	setUp {
		TestCase.setUpPortalInstance();

		User.firstLoginPG();

		task ("Given a feature flag deprecation property is set, When access deprecation feature flag at Instance Settings") {
			ApplicationsMenu.gotoPortlet(
				category = "Configuration",
				panel = "Control Panel",
				portlet = "Instance Settings");

			PortalSettings.gotoConfiguration(
				configurationCategory = "Feature Flags",
				configurationName = "Deprecation",
				configurationScope = "Virtual Instance Scope");
		}
	}

	tearDown {
		var testLiferayVirtualInstance = PropsUtil.get("test.liferay.virtual.instance");

		if (${testLiferayVirtualInstance} == "true") {
			PortalInstances.tearDownCP();
		}
	}

	@description = "LPS-189292 - This test asserts that a deprecated feature flag can be utilized."
	@priority = 5
	test CanBeUtilized {
		property portal.acceptance = "true";

		task ("And enable deprecation feature flag at Instance Settings") {
			Check.checkToggleSwitch(
				locator1 = "FeatureFlag#TOGGLE_ROW",
				title_row = "Test Deprecation Title 404 sample page",
				toggle_state = "Disabled");
		}

		task ("Then the feature can be utilized") {
			AssertElementPresent(
				locator1 = "FeatureFlag#TOGGLE_ROW",
				title_row = "Test Deprecation Title 404 sample page",
				toggle_state = "Enabled");
		}
	}

	@description = "LPS-189292 - This test asserts that a deprecated feature flag can be utilized."
	@priority = 5
	test CannotBeUtilized {
		property portal.acceptance = "true";

		task ("And When disable deprecation feature flag at Instance Settings") {
			if (IsElementPresent(locator1 = "FeatureFlag#TOGGLE_ROW", title_row = "Test Deprecation Title 404 sample page", toggle_state = "Disabled")) {
				Check.checkToggleSwitch(
					locator1 = "FeatureFlag#TOGGLE_ROW",
					title_row = "Test Deprecation Title 404 sample page",
					toggle_state = "Disabled");
			}

			ClickNoError(
				locator1 = "FeatureFlag#TOGGLE_ROW",
				title_row = "Test Deprecation Title 404 sample page",
				toggle_state = "Enabled");
		}

		task ("Then the feature cannot be utilized") {
			AssertElementNotPresent(
				locator1 = "FeatureFlag#TOGGLE_ROW",
				title_row = "Test Deprecation Title 404 sample page",
				toggle_state = "Enabled");
		}
	}

	@description = "LPS-189292 - This test asserts that a deprecated feature flag is disabled by default."
	@priority = 4
	test IsDisabledByFefaultOnMaster {
		property portal.acceptance = "true";

		task ("Then the feature flag is disabled by default") {
			AssertElementPresent(
				locator1 = "FeatureFlag#TOGGLE_ROW",
				title_row = "Test Deprecation Title 404 sample page",
				toggle_state = "Disabled");
		}
	}

	@description = "LPS-189292 - This test asserts that a deprecated feature flag is not visible when 'ui.visible[deprecation]=false'."
	@priority = 4
	test IsNotVisibleWhenUIVisibleIsSetToFalse {
		property portal.acceptance = "true";

		task ("Then the Deprecation scope is not visible") {
			AssertElementNotPresent(
				locator1 = "FeatureFlag#TOGGLE_ROW",
				title_row = "Test Deprecation Title 404 sample page",
				toggle_state = "Disabled");
		}
		task ("Then deprecation feature flag is not listed in other virtual scopes") {
			ApplicationsMenu.gotoPortlet(
				category = "Configuration",
				panel = "Control Panel",
				portlet = "Instance Settings");

			PortalSettings.gotoConfiguration(
				configurationCategory = "Feature Flags",
				configurationName = "Deprecation",
				configurationScope = "Virtual Instance Scope");
			
			AssertElementNotPresent(
				locator1 = "FeatureFlag#TOGGLE_ROW",
				title_row = "Test Deprecation Title 404 sample page",
				toggle_state = "Disabled");
		}
	}

}